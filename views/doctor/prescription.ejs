        <!-- History -->
        <div class="dashboard-panel">
          <div class="dashboard-panel-header">
            <h3>Prescription History</h3>
          </div>
          <div class="dashboard-panel-body no-pad">
            <div class="table-wrapper">
              <table class="table">
                <thead>
                  <tr><th>Rx No.</th><th>Patient</th><th>Date</th><th>Diagnosis</th><th>Actions</th></tr>
                </thead>
                <tbody>
                  <% for(var i=0;i<prescription.length;i++){ %>
                  <tr>
                    <td><code><%=i+1%></code></td>
                    <td><%= prescription[i].p_id %> </td>
                    <td><%= new Date(prescription[i].pre_date).toLocaleDateString('en-GB') %></td>
                    <td><%= prescription[i].pre_diagnosis %> </td>
                    <td class="table-actions"><a href="/doctor/prescription_view/<%= prescription[i].prescription_id %>/<%= prescription[i].p_id %>"><button type="button" class="btn btn-sm btn-outline"><i class="fa-solid fa-eye"></i></button></a></td>
                  </tr>
                  <% } %>
