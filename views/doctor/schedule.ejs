<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="MediCare Plus Doctor Panel — manage your weekly availability and leave requests." />
  <title>Schedule | Doctor Panel | MediCare Plus</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="../css/main.css" />
</head>
<body class="dashboard-body" data-role="doctor" data-page="schedule">

  <div class="dashboard-layout role-doctor" data-role="doctor">

    <!-- ===================== SIDEBAR ===================== -->
    <aside class="sidebar" id="sidebar">
      <a href="dashboard.html" class="sidebar-brand">
        <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
        <span class="sidebar-brand-text">Medi<span>Care</span> Plus</span>
      </a>

      <div class="sidebar-user">
        <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=200&q=80" alt="Dr. Sarah Mitchell" />
        <div class="sidebar-user-info">
          <h5>Dr. Sarah Mitchell</h5>
          <span>Cardiology</span>
        </div>
      </div>

      <nav class="sidebar-nav" aria-label="Doctor navigation">
        <span class="nav-section-label">Overview</span>
        <a href="dashboard.html" class="nav-item"><i class="fa-solid fa-gauge-high"></i><span class="nav-label">Dashboard</span></a>
        <a href="profile.html" class="nav-item"><i class="fa-solid fa-user-doctor"></i><span class="nav-label">Profile</span></a>

        <span class="nav-section-label">Patient Care</span>
        <a href="appointments.html" class="nav-item">
          <i class="fa-solid fa-calendar-check"></i><span class="nav-label">Appointments</span>
          <span class="nav-badge">5</span>
        </a>
        <a href="patients.html" class="nav-item"><i class="fa-solid fa-hospital-user"></i><span class="nav-label">Patients</span></a>
        <a href="treatment.html" class="nav-item"><i class="fa-solid fa-notes-medical"></i><span class="nav-label">Treatment Notes</span></a>
        <a href="prescription.html" class="nav-item"><i class="fa-solid fa-file-prescription"></i><span class="nav-label">Prescriptions</span></a>
        <a href="reports.html" class="nav-item"><i class="fa-solid fa-file-medical"></i><span class="nav-label">Reports</span></a>

        <span class="nav-section-label">Planning</span>
        <a href="schedule.html" class="nav-item active"><i class="fa-solid fa-calendar-days"></i><span class="nav-label">Schedule</span></a>
        <a href="dashboard.html#notifications" class="nav-item"><i class="fa-solid fa-bell"></i><span class="nav-label">Notifications</span></a>
      </nav>

      <div class="sidebar-footer">
        <a href="../index.html" class="nav-item"><i class="fa-solid fa-globe"></i><span class="nav-label">Website</span></a>
        <a href="../login.html" class="nav-item"><i class="fa-solid fa-right-from-bracket"></i><span class="nav-label">Logout</span></a>
      </div>
    </aside>

    <div class="sidebar-overlay"></div>

    <!-- ===================== MAIN ===================== -->
    <div class="dashboard-main">

      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Schedule</h1>
            <p>Set your weekly availability and request time off</p>
          </div>
        </div>
        <div class="topbar-right">
          <button type="button" class="topbar-btn theme-toggle" aria-label="Toggle theme"><i class="fa-solid fa-moon"></i></button>
          <div class="topbar-btn-wrap dropdown">
            <button type="button" class="topbar-btn" data-dropdown aria-label="Notifications">
              <i class="fa-solid fa-bell"></i>
              <span class="notif-badge">3</span>
            </button>
            <div class="notif-dropdown">
              <div class="notif-dropdown-header">
                <h4>Notifications</h4>
                <a href="dashboard.html#notifications">Mark all read</a>
              </div>
              <div class="notification-list">
                <div class="notification-item unread">
                  <div class="notification-icon success"><i class="fa-solid fa-user-plus"></i></div>
                  <div class="notification-body">
                    <h5>New Patient Assigned</h5>
                    <p>Michael Carter has been assigned to your care.</p>
                    <span class="notif-time">1 hour ago</span>
                  </div>
                </div>
                <div class="notification-item unread">
                  <div class="notification-icon"><i class="fa-solid fa-calendar-check"></i></div>
                  <div class="notification-body">
                    <h5>Appointment Request</h5>
                    <p>Priya Anand requested an appointment for Jul 29.</p>
                    <span class="notif-time">3 hours ago</span>
                  </div>
                </div>
                <div class="notification-item">
                  <div class="notification-icon warning"><i class="fa-solid fa-flask"></i></div>
                  <div class="notification-body">
                    <h5>Lab Result Alert</h5>
                    <p>Abnormal result flagged for patient Daniel Osei.</p>
                    <span class="notif-time">Yesterday</span>
                  </div>
                </div>
              </div>
              <div class="notif-dropdown-footer">
                <a href="dashboard.html#notifications">View All Notifications</a>
              </div>
            </div>
          </div>
          <div class="profile-dropdown dropdown">
            <button type="button" class="profile-trigger" data-dropdown>
              <img src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=200&q=80" alt="Dr. Sarah Mitchell" />
              <span class="profile-name">Dr. Sarah Mitchell</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong>Dr. Sarah Mitchell</strong>
                <span>Cardiology</span>
              </div>
              <a href="profile.html"><i class="fa-solid fa-user"></i> My Profile</a>
              <a href="schedule.html"><i class="fa-solid fa-calendar-days"></i> My Schedule</a>
              <div class="divider"></div>
              <a href="../login.html" class="danger"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content">

        <!-- Working hours summary -->
        <div class="dashboard-panel" style="margin-bottom:1.75rem;">
          <div class="dashboard-panel-header">
            <h3>Standard Working Hours</h3>
          </div>
          <div class="dashboard-panel-body">
            <div class="schedule-list">
              <div class="schedule-item">
                <div class="schedule-divider"></div>
                <div class="schedule-info"><h5>Monday – Friday</h5><p>9:00 AM – 5:00 PM</p></div>
                <span class="badge badge-success">Available</span>
              </div>
              <div class="schedule-item">
                <div class="schedule-divider orange"></div>
                <div class="schedule-info"><h5>Saturday</h5><p>9:00 AM – 1:00 PM</p></div>
                <span class="badge badge-success">Available</span>
              </div>
              <div class="schedule-item">
                <div class="schedule-divider red"></div>
                <div class="schedule-info"><h5>Sunday</h5><p>Not available</p></div>
                <span class="badge badge-cancelled">Closed</span>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-grid">
          <!-- Weekly availability grid -->
          <div class="col-7">
            <div class="dashboard-panel">
              <div class="dashboard-panel-header">
                <h3>Weekly Availability</h3>
              </div>
              <div class="dashboard-panel-body">
                <form action="#" method="post">
                  <div class="schedule-list">
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="monday" checked /> Monday</label>
                      <input type="time" name="mondayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="mondayEnd" class="form-control" value="17:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="tuesday" checked /> Tuesday</label>
                      <input type="time" name="tuesdayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="tuesdayEnd" class="form-control" value="17:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="wednesday" checked /> Wednesday</label>
                      <input type="time" name="wednesdayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="wednesdayEnd" class="form-control" value="17:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="thursday" checked /> Thursday</label>
                      <input type="time" name="thursdayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="thursdayEnd" class="form-control" value="17:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="friday" checked /> Friday</label>
                      <input type="time" name="fridayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="fridayEnd" class="form-control" value="17:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="saturday" checked /> Saturday</label>
                      <input type="time" name="saturdayStart" class="form-control" value="09:00" style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="saturdayEnd" class="form-control" value="13:00" style="max-width:130px;" />
                    </div>
                    <div class="schedule-item">
                      <label style="display:flex;align-items:center;gap:0.5rem;min-width:110px;"><input type="checkbox" name="available[]" value="sunday" /> Sunday</label>
                      <input type="time" name="sundayStart" class="form-control" value="09:00" disabled style="max-width:130px;" />
                      <span class="text-muted">to</span>
                      <input type="time" name="sundayEnd" class="form-control" value="13:00" disabled style="max-width:130px;" />
                    </div>
                  </div>
                  <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Availability</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <!-- Leave request -->
          <div class="col-5">
            <div class="dashboard-panel" style="margin-bottom:1.25rem;">
              <div class="dashboard-panel-header">
                <h3>Request Leave</h3>
              </div>
              <div class="dashboard-panel-body">
                <form action="#" method="post">
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">From <span class="required">*</span></label>
                      <input type="date" name="fromDate" class="form-control" required />
                    </div>
                    <div class="form-group">
                      <label class="form-label">To <span class="required">*</span></label>
                      <input type="date" name="toDate" class="form-control" required />
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Reason <span class="required">*</span></label>
                    <textarea name="reason" class="form-control" placeholder="e.g. Attending a medical conference" required></textarea>
                  </div>
                  <div class="form-actions" style="justify-content:flex-start;">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Submit Request</button>
                  </div>
                </form>
              </div>
            </div>

            <div class="dashboard-panel">
              <div class="dashboard-panel-header">
                <h3>Leave Requests</h3>
              </div>
              <div class="dashboard-panel-body">
                <div class="schedule-list">
                  <div class="schedule-item">
                    <div class="schedule-divider orange"></div>
                    <div class="schedule-info"><h5>Aug 10 – Aug 12, 2026</h5><p>Attending a medical conference</p></div>
                    <span class="badge badge-pending">Pending</span>
                  </div>
                  <div class="schedule-item">
                    <div class="schedule-divider"></div>
                    <div class="schedule-info"><h5>Jun 05 – Jun 06, 2026</h5><p>Personal leave</p></div>
                    <span class="badge badge-approved">Approved</span>
                  </div>
                  <div class="schedule-item">
                    <div class="schedule-divider red"></div>
                    <div class="schedule-info"><h5>Mar 14, 2026</h5><p>Family emergency</p></div>
                    <span class="badge badge-approved">Approved</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="../js/main.js"></script>
</body>
</html>
