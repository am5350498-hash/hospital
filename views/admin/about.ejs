<%- include('header.ejs'); %>

    <div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>About Us</h1>
            <p>Learn more about our hospital and services</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="treatments-search" placeholder="Search treatments…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="/login" class="danger logout-btn" data-logout="/login"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="page-toolbar">
          <h2>About Us</h2>
          <div class="page-toolbar-actions">
            
          </div>
        </div>
        <div class="">
           <form action="/admin/about_save" method="post" enctype="multipart/form-data">
      <div class="modal-body">
        <input type="hidden" name="id" />
        
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="treat-name">Title <span class="required">*</span></label>
            <input type="text" id="treat-name" name="wname" class="form-control" value=""  required />
          </div>
          
          <div class="form-group">
            <label class="form-label" for="dept-icon">Icon (Font Awesome class)</label>
            <input type="text" id="dept-icon" name="wicon" class="form-control" placeholder="fa-solid fa-heart-pulse" />
          </div>

        </div>
        
        <div class="form-group">
          <label class="form-label" for="treat-description">Description</label>
          <textarea id="treat-description" name="wdescription" class="form-control" rows="3" placeholder="Brief description of the about"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <a href="/admin/about" class="btn btn-primary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Add About</button>
      </div>
    </form>
        </div>

        <div class="table-wrapper">
          <table class="table" id="patients-table">
             <thead>
              <tr>
                <th>Title</th>
                <th>Icon</th>
                <th>Description</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody >
            <tbody>
    <% for(var i = 0; i < data.length; i++) { %>
    <tr>
        <td><%= data[i].wname %></td>
        <td><%= data[i].wicon %></td>
        <td><%= data[i].wdescription %></td>
        <td>
            <a href="/admin/about_edit/<%= data[i].wid %>">
                <button class="btn"><i class="fa fa-pencil"></i></button>
            </a>

            <a href="/admin/about_delete/<%= data[i].wid %>" 
   onclick="return confirm('Are you sure you want to delete this about entry?')">
                <button class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                
            </a>
        </td>
    </tr>
    <% } %>
</tbody>


          </table>
          </div>
          <br><br>

      
        <div class="pagination" id="treatments-pagination"></div>
      </main>
    </div>
  </div>


<!-- Our Journey -->

   <div class="dashboard-main">
      <header class="topbar">
        
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
             <h2>Our Journey</h2>
          </div>
          <div class="profile-dropdown">
          </div>
        </div>
      </header>

      <main class="dashboard-content">
        <div class="page-toolbar">
          <div class="page-toolbar-actions">
            
          </div>
        </div>
        <div class="">
           <form action="/admin/journey_save" method="post" enctype="multipart/form-data">
      <div class="modal-body">
        <input type="hidden" name="id" />
        
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="treat-name">Title <span class="required">*</span></label>
            <input type="text" id="treat-name" name="jname" class="form-control" value=""  required />
          </div>
          
          <div class="form-group">
            <label class="form-label" for="dept-icon">Year</label>
            <input type="text" id="dept-icon" name="jyear" class="form-control" placeholder="2026" />
          </div>

        </div>
        
        <div class="form-group">
          <label class="form-label" for="treat-description">Description</label>
          <textarea id="treat-description" name="jdescription" class="form-control" rows="3" placeholder="Brief description of the journey..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <a href="/admin/about" class="btn btn-primary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Add Journey</button>
      </div>
    </form>
        </div>

        <div class="table-wrapper">
          <table class="table" id="patients-table">
             <thead>
              <tr>
                <th>Title</th>
                <th>Year</th>
                <th>Description</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody >
            <tbody>
    <% for(var i = 0; i < data1.length; i++) { %>
    <tr>
        <td><%= data1[i].jname %></td>
        <td><%= data1[i].jyear %></td>
        <td><%= data1[i].jdescription %></td>
        <td>
            <a href="/admin/journey_edit/<%= data1[i].jid %>">
                <button class="btn"><i class="fa fa-pencil"></i></button>
            </a>

            <a href="/admin/journey_delete/<%= data1[i].jid %>" 
   onclick="return confirm('Are you sure you want to delete this journey ?')">
                <button class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                
            </a>
        </td>
    </tr>
    <% } %>
</tbody>

          </table>
          </div>
          <br><br>
        <div class="pagination" id="treatments-pagination"></div>
      </main>
    </div>
  </div>
 

<!-- Review Section -->

