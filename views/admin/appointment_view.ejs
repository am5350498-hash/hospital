<%- include('header.ejs'); %>

<div class="dashboard-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="sidebar-toggle" aria-label="Toggle sidebar"><i class="fa-solid fa-bars"></i></button>
          <div class="topbar-title">
            <h1>Appointments</h1>
            <p>All patient bookings across every department</p>
          </div>
        </div>
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" id="appointments-search" placeholder="Search by patient or doctor…" />
        </div>
        <div class="topbar-right">
          <div class="topbar-btn-wrap">
            <button type="button" class="topbar-btn" data-notifications aria-label="Notifications"><i class="fa-solid fa-bell"></i></button>
          </div>
          <div class="profile-dropdown">
            <button type="button" class="profile-trigger">
              <img data-current-user-avatar src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&w=200&q=80" alt="" />
              <span class="profile-name" data-current-user-name>System Admin</span>
              <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="profile-menu">
              <div class="profile-menu-header">
                <strong data-current-user-name>System Admin</strong>
                <span data-current-user-email>admin@medicare.com</span>
              </div>
              <a href="settings.html"><i class="fa-solid fa-gear"></i> Settings</a>
              <div class="divider"></div>
              <a href="/login" class="danger logout-btn" data-logout="login.html"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
          </div>
        </div>
      </header>

<div class="dashboard-content"></div>

<!-- Printable preview -->
       <div style="margin-bottom:1.75rem;">
          <div class="page-toolbar" style="margin-bottom:1rem;">
            <h2>Prescription Preview</h2>
            <div class="page-toolbar-actions">
              <button type="button" class="btn btn-primary btn-sm"><i class="fa-solid fa-print"></i> Print</button>
            </div>
          </div>

          <div class="prescription-area prescription-print">
            <div class="prescription-header">
              <div class="rx-brand">
                <span class="logo-icon"><i class="fa-solid fa-hospital"></i></span>
                <div>
                  <h2>MediCare Plus</h2>
                  <p>1250 Healing Way, Suite 100, Health City, HC 90210</p>
                </div>
              </div>
              <div class="rx-meta">
                <strong><%= data1[0].dname %></strong>
                <span><%= data1[0].name %></span><br />
                <span>Rx No: RX2041</span><br />
                <span>Date: <%= new Date(data[0].pre_date).toLocaleDateString('en-GB') %></span>
              </div>
            </div>

            <div class="prescription-patient">
              <div class="rx-field">
                <label>Patient Name</label>
                <span><%= customer.p_name %></span>
              </div>
              <div class="rx-field">
                <label>Age / Gender</label>
                <span><%= customer.p_age %> / <%= customer.p_gender %></span>
              </div>
              <div class="rx-field">
                <label>Patient ID</label>
                <span>PT-<%= data[0].p_id %></span>
              </div>
            </div>

            <div class="rx-field" style="margin-bottom:1.5rem;">
              <label>Diagnosis</label>
              <span><%= data[0].pre_diagnosis %></span>
            </div>

            <div class="prescription-rx">
              <div class="rx-symbol">℞</div>
              <table class="prescription-meds">
                <thead>
                  <tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th></tr>
                </thead>
                <tbody>
                    <% for(var i=0;i<data.length;i++){ %>
                  <tr><td><%= data[i].medicine %></td><td><%= data[i].dosage %></td><td><%= data[i].frequency %></td><td><%= data[i].duration %></td></tr>
                <% } %>
                </tbody>
              </table>
            </div>

            <div class="prescription-notes">
              <h5><i class="fa-solid fa-circle-info"></i> Advice</h5>
              <p><%= data[0].advice %></p>
              <!-- <p>Continue daily walks and low-sodium diet. Recheck blood pressure and lipid panel in 6 weeks.</p> -->
            </div>

            <div class="prescription-footer">
              <div>
                <p class="text-muted" style="font-size:0.8rem;margin:0;">This is a computer-generated prescription — MediCare Plus.</p>
              </div>
              <div class="rx-signature">
                <div class="sig-line"></div>
                <span><%= data1[0].dname %></span>
              </div>
            </div>
          </div>
        </div> 
        <%- include('footer.ejs'); %>
