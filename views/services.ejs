<%- include('header.ejs'); %>

    <section class="page-banner">
      <div class="container">
        <h1>Our Services</h1>
        <div class="breadcrumb">
          <a href="index.html">Home</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Services</span>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-aos="fade-up">
          <span class="eyebrow">Hospital-Wide Services</span>
          <h2>Comprehensive Care, All in One Place</h2>
          <p>Beyond our specialty departments, MediCare Plus operates a full range of hospital services — from emergency response to home sample collection — designed to support you at every stage of care.</p>
        </div>

        <div class="service-list">
          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1582719471384-894fbb16e074?auto=format&fit=crop&w=400&q=80" alt="Emergency care team" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-truck-medical text-primary"></i> 24/7 Emergency &amp; Trauma Care</h4>
              <p>Round-the-clock emergency department staffed with trauma-trained physicians, rapid triage, and on-call ambulance dispatch.</p>
            </div>
            <a href="tel:108" class="btn btn-danger btn-sm">Call 108</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&w=400&q=80" alt="Intensive care unit" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-bed-pulse text-primary"></i> Intensive &amp; Critical Care (ICU)</h4>
              <p>State-of-the-art ICU and NICU units with continuous monitoring and a 1:2 nurse-to-patient ratio for critical cases.</p>
            </div>
            <a href="contact.html" class="btn btn-outline btn-sm">Learn More</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=400&q=80" alt="Diagnostic imaging lab" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-x-ray text-primary"></i> Diagnostic Imaging &amp; Laboratory</h4>
              <p>On-site MRI, CT, X-ray, ultrasound, and full-service pathology lab with same-day results for most tests.</p>
            </div>
            <a href="appointment.html" class="btn btn-outline btn-sm">Book a Scan</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1587854691252-dc440b2234b7?auto=format&fit=crop&w=400&q=80" alt="Hospital pharmacy" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-prescription-bottle-medical text-primary"></i> In-House Pharmacy</h4>
              <p>Full-service pharmacy stocking prescription and over-the-counter medication with pharmacist consultation.</p>
            </div>
            <a href="contact.html" class="btn btn-outline btn-sm">Contact Pharmacy</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?auto=format&fit=crop&w=400&q=80" alt="Physiotherapy and rehabilitation gym" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-dumbbell text-primary"></i> Physiotherapy &amp; Rehabilitation</h4>
              <p>Personalized recovery programs after surgery, injury, or stroke — led by licensed physiotherapists.</p>
            </div>
            <a href="appointment.html" class="btn btn-outline btn-sm">Book a Session</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=400&q=80" alt="Telehealth video consultation" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-video text-primary"></i> Telehealth Consultations</h4>
              <p>Secure video visits with select specialists for follow-ups, prescriptions, and minor concerns — from home.</p>
            </div>
            <a href="appointment.html" class="btn btn-outline btn-sm">Book Telehealth</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1584982751601-97dcc096659c?auto=format&fit=crop&w=400&q=80" alt="Ambulance service" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-truck-medical text-primary"></i> Ambulance &amp; Patient Transport</h4>
              <p>Fully-equipped ambulance fleet with paramedic staff for emergency dispatch and inter-facility transfers.</p>
            </div>
            <a href="tel:108" class="btn btn-outline btn-sm">Request Ambulance</a>
          </div>

          <div class="service-list-item" data-aos="fade-up">
            <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=400&q=80" alt="Health checkup package" loading="lazy" />
            <div>
              <h4><i class="fa-solid fa-clipboard-check text-primary"></i> Preventive Health Checkups</h4>
              <p>Comprehensive annual screening packages covering blood work, vitals, imaging, and specialist review.</p>
            </div>
            <a href="appointment.html" class="btn btn-outline btn-sm">Book Checkup</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Link to Treatments -->
    <section class="section bg-alt">
      <div class="container">
        <div class="cta-banner" data-aos="fade-up">
          <div class="container">
            <h2>Looking for a Specific Treatment or Procedure?</h2>
            <p>Browse our full catalog of specialized treatments with pricing, duration, and what to expect.</p>
            <div class="btn-group">
              <a href="treatment.html" class="btn btn-white btn-lg"><i class="fa-solid fa-stethoscope"></i> Explore Treatments</a>
              <a href="appointment.html" class="btn btn-outline-white btn-lg">Book an Appointment</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  
